# ---- Public (safe in the browser) ----
NEXT_PUBLIC_FACTORY_ADDRESS=          # from `forge script script/Deploy.s.sol` output
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# ---- Server-only secrets (Vercel env vars, never commit) ----
APP_URL=http://localhost:3000         # your Vercel URL in production, used for configURI
PLATFORM_PRIVATE_KEY=                 # 0x... a FRESH testnet-only wallet funded from faucet.monad.xyz
RPC_URL=https://testnet-rpc.monad.xyz

# AI (Gemini). Picks a preset or writes a custom game. Leave empty to use the offline generator
# (presets only). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash         # any Gemini model id
LLM_TIMEOUT_MS=25000                  # budget for the config call

# Supabase (leave empty in dev to use the local .data/ store).
# Use the new secret key (sb_secret_...). SUPABASE_SECRET_ROLE_KEY / SUPABASE_SERVICE_ROLE_KEY
# are also accepted. Server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=game-images

LAUNCHES_ENABLED=true                 # kill switch
CRON_SECRET=                          # Vercel Cron auth for /api/cron/settle (daily prize payout)
